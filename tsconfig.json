{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "types": ["vite/client", "node"],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "next/navigation": ["./src/shims/next-navigation.tsx"],
      "next/link": ["./src/shims/next-link.tsx"],
      "next/image": ["./src/shims/next-image.tsx"],
      "next/dynamic": ["./src/shims/next-dynamic.tsx"],
      "next/font/google": ["./src/shims/next-font.ts"],
      "next/font/local": ["./src/shims/next-font.ts"],
      "next": ["./src/shims/next.ts"],
      "@marsidev/react-turnstile": ["./src/shims/turnstile.tsx"],
      "@simplewebauthn/browser": ["./src/shims/webauthn.ts"],
      "@fingerprintjs/fingerprintjs": ["./src/shims/fingerprintjs.ts"],
      "server-only": ["./src/shims/server-only.ts"],
      "@/*": ["./src/*"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": ["dist"]
}
